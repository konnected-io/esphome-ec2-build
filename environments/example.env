# Copy to environments/<name>.env (e.g. dev.env, prod.env) and fill in; <name>.env files are gitignored.
# Used by ./launch.sh <name>

# AWS account the instance runs in; launch.sh refuses to run with credentials for another account
ACCOUNT_ID=123456789012
INSTANCE_TYPE=t4g.micro
# EC2 key pair for SSH access
KEY_NAME=esphome-cloud-build-key
# written to ~/.env on the instance; build.sh uses it to pick the failure-handler Lambda
KONNECTED_ENV=dev
